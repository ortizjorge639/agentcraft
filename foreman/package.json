{
  "name": "agentcraft-foreman",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AgentCraft Foreman: Claude and GitHub Copilot multi-agent orchestrator rendered by Minecraft.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "tui": "node --import tsx scripts/fake-mod.ts",
    "test": "vitest run",
    "test:sdk": "node --import tsx scripts/copilot-smoke.ts",
    "typecheck": "tsc --noEmit",
    "gen:protocol-doc": "node --import tsx scripts/gen-protocol-doc.ts",
    "check:protocol-doc": "node --import tsx scripts/gen-protocol-doc.ts --check",
    "check": "tsc --noEmit && vitest run && node --import tsx scripts/gen-protocol-doc.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@github/copilot-sdk": "1.0.16",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
